rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public previews
    match /previews/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Original coursework files
    match /original_works/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Order attachments and chat files
    match /order_attachments/{orderId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Plagiarism reports and certificates
    match /plagiarism_certificates/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
